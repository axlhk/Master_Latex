  eprinttype = {arXiv},
  doi = {10.48550/arXiv.quant-ph/0101025},
  url = {http://arxiv.org/abs/quant-ph/0101025},
  urldate = {2026-01-29},
  abstract = {The theory of quantum computation can be constructed from the abstract study of anyonic systems. In mathematical terms, these are unitary topological modular functors. They underlie the Jones polynomial and arise in Witten-Chern-Simons theory. The braiding and fusion of anyonic excitations in quantum Hall electron liquids and 2D-magnets are modeled by modular functors, opening a new possibility for the realization of quantum computers. The chief advantage of anyonic computation would be physical error correction: An error rate scaling like \$e\textasciicircum\{-\textbackslash ał\}\$, where \$ł\$ is a length scale, and \$α\$ is some positive constant. In contrast, the \$\textbackslash q\$presumptive" qubit-model of quantum computation, which repairs errors combinatorically, requires a fantastically low initial error rate (about \$10\textasciicircum\{-4\}\$) before computation can be stabilized.},
  pubstate = {prepublished},
  keywords = {Mathematics - Geometric Topology,Quantum Physics},
  file = {C\:\\Users\\axlkl\\Zotero\\storage\\N6EZ4URJ\\Freedman et al. - 2002 - Topological Quantum Computation.pdf;C\:\\Users\\axlkl\\Zotero\\storage\\J7YU3Q9Y\\0101025.html}
}

@article{frolovDataSharingHelps2026,
