\newlabel{fig:T_chain_gs_fully_topo}{{5.3}{31}{Initial ground state coefficient and energy spectrum for the fully topological T-chain for the appropriate superconducting term where the vertical arm has $\Delta = -1$, and the horizontal arms have $\Delta = 1$}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Probability of the adiabatic basis and the energy levels (subtracted the ground state) for time evolution of the switching of Majoranas 2 and 3 in the central operation of the Pauli-X gate. Using $N = 10$, showing all $\text  {trunc} = 150$ states, using $T=20$, and the appropriate parameters $\omega = 1 |\Delta | = 1$ with $\mu (j, \tau )$ as in equation \ref {eq:r(tau)_Pauli_x}. The parameters are visualized in Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The ground state energy is four-fold degenerate.}}{32}{figure.caption.23}\protected@file@percent }
\newlabel{fig:Pauli_x_gate_1_negative_delta}{{5.4}{32}{Probability of the adiabatic basis and the energy levels (subtracted the ground state) for time evolution of the switching of Majoranas 2 and 3 in the central operation of the Pauli-X gate. Using $N = 10$, showing all $\text {trunc} = 150$ states, using $T=20$, and the appropriate parameters $\omega = 1 |\Delta | = 1$ with $\mu (j, \tau )$ as in equation \ref {eq:r(tau)_Pauli_x}. The parameters are visualized in Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The ground state energy is four-fold degenerate}{figure.caption.23}{}}
