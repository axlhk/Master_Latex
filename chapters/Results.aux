\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Probability of the adiabatic basis and the energy levels (subtracted the ground state) for time evolution of the switching of Majoranas 2 and 3 as shown in fig.1c \blx@tocontentsinit {0}\cite {sahuNoisyBraidingMajorana2026} illustrations 2 and 3. Using $N = 10$, truncation $= 150$, $T=20$, and the parameters of the Hamiltonian as shown in Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The ground state energy is four-fold degenerate.}}{31}{figure.caption.18}\protected@file@percent }
\newlabel{fig:Pauli_x_gate_1_negative_delta}{{5.3}{31}{Probability of the adiabatic basis and the energy levels (subtracted the ground state) for time evolution of the switching of Majoranas 2 and 3 as shown in fig.1c \cite {sahuNoisyBraidingMajorana2026} illustrations 2 and 3. Using $N = 10$, truncation $= 150$, $T=20$, and the parameters of the Hamiltonian as shown in Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The ground state energy is four-fold degenerate}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Time dependencies of the parameters for time evolution of the switching of Majoranas 2 and 3 as shown in fig.1c \blx@tocontentsinit {0}\cite {sahuNoisyBraidingMajorana2026} illustrations 2 and 3. Used in creating Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The whole T-junction has $\omega = 1$. Arms 0 and 1 (or the horizontal chain if you will) have $\Delta = 1$, whereas the vertical chain has $\Delta = -1$. $\mu $ is defined by \ref {eq:mu_from_sahuNoisyBraiding} using $\mu _\text  {triv} = 8$, $\mu _\text  {topo} = 0.05$.}}{31}{figure.caption.19}\protected@file@percent }
\newlabel{fig:Pauli_x_gate_params_1_negative_delta}{{5.4}{31}{Time dependencies of the parameters for time evolution of the switching of Majoranas 2 and 3 as shown in fig.1c \cite {sahuNoisyBraidingMajorana2026} illustrations 2 and 3. Used in creating Figure \ref {fig:Pauli_x_gate_params_1_negative_delta}. The whole T-junction has $\omega = 1$. Arms 0 and 1 (or the horizontal chain if you will) have $\Delta = 1$, whereas the vertical chain has $\Delta = -1$. $\mu $ is defined by \ref {eq:mu_from_sahuNoisyBraiding} using $\mu _\text {triv} = 8$, $\mu _\text {topo} = 0.05$}{figure.caption.19}{}}
